# DeepSeek Harness — Docker environment template.
#
# Copy to `.env` and fill in real values:  cp .env.example .env
# `.env` is git- and dockerignore-ignored — NEVER commit real keys.
# At runtime, prefer `docker run -e DEEPSEEK_API_KEY=...` or an env_file
# over baking the value into the image.

# Required: DeepSeek API key for LLM calls. Inject at runtime, never in build.
DEEPSEEK_API_KEY=

# Optional: override the API endpoint (e.g. a self-hosted gateway).
DEEPSEEK_BASE_URL=

# --- DSH runtime knobs (all optional) ---------------------------------------
# Profile to boot on container start (passed as: dsh --profile <name>).
# "web" starts the Web UI (a long-running server); "headless" runs one task.
# The profile must exist under $DSH_HOME/profiles/<name> — mount it or init
# with: docker compose run --rm dsh plugin --profile <name> add <package>
DSH_PROFILE=web
# UID the entrypoint drops privileges to (must match DSH_UID build arg).
# DSH_UID=1001
# Sessions directory inside the container.
# DSH_SESSIONS_DIR=/app/.sessions
# Storages directory inside the container.
# DSH_STORAGES_DIR=/app/.storages
# External port nginx listens on (mapped 1:1 to the host). The web app always
# binds 127.0.0.1; nginx proxies to it on an internal loopback port.
DSH_WEB_PORT=3080
# CIDR allowed to reach the Web UI via the nginx reverse proxy. The app stays
# bound to 127.0.0.1 (safe); nginx binds 0.0.0.0 and enforces this allowlist.
# Set empty to disable nginx and use network_mode: host (loopback-only access).
DSH_ALLOW_CIDR=192.168.0.0/24
